# Copy to .env and adjust. Every value here has a working default, so a clone
# runs with no .env at all - against SQLite, with authentication off.
#
# docker-compose reads this same file; see docker-compose.yml.

# ---------------------------------------------------------------- database
# SQLite for local development:
HALCYON_DATABASE_URL="sqlite:///./database.db"
# Postgres, as docker-compose runs it:
# HALCYON_DATABASE_URL="postgresql+psycopg://halcyon:halcyon@db:5432/halcyon"

# Credentials the compose stack creates the database with. Change them for
# anything that is not a local machine.
POSTGRES_USER="halcyon"
POSTGRES_PASSWORD="halcyon"
POSTGRES_DB="halcyon"

# --------------------------------------------------------- authentication
# Left empty the API is open, which is what keeps a bare `uvicorn` and the test
# suite frictionless. Set it and every write needs the X-API-Key header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
HALCYON_API_KEY=""

# ---------------------------------------------------------------- runtime
HALCYON_ENVIRONMENT="development"

# Only matters for a browser calling the API directly; the web client calls it
# from its own server. Comma-separated.
HALCYON_CORS_ORIGINS="http://localhost:3000"

# ----------------------------------------------------------------- clients
# Where the web and terminal clients look for the API. Inside compose the web
# container reaches it as http://api:8000.
HALCYON_API_BASE_URL="http://127.0.0.1:8000"
